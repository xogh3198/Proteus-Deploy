# Proteus 독립 GPU 실행 기본값. 변경할 때는 proteus-docker.local.env로 복사합니다.
# 스크립트는 현재 터미널의 Docker를 사용하며 context나 data-root를 바꾸지 않습니다.
PYTHON_IMAGE=python:3.11-slim-bookworm
TORCH_VERSION=2.11.0+cu126
TORCHVISION_VERSION=0.26.0+cu126
WORKER_IMAGE=proteus-worker:cpu-ready-v1
# 호스트 GPU 번호 한 개. 컨테이너 안에서는 선택한 장치가 0번으로 보입니다.
GPU=2
GPU_TYPE=v100
APPLICATION=imagenet
MODEL_NAME=resnet-50
# Optional SINGLE-model override. Leave both empty to use MODEL_REGISTRY.
MODEL_ID=
MODEL_REVISION=
MODEL_REGISTRY=deploy/docker/models.json
# 가중치와 실험 데이터 경로. 상대 경로는 저장소 루트 기준입니다.
# 4TB 예: /data4tb/taeho-proteus/models, /data4tb/taeho-proteus/experiments
MODEL_DIR=data/proteus/models
DATA_DIR=data/proteus
INPUT_IMAGE=inputs/test-dog.jpg
EVAL_DIR=data/proteus/eval
# 별도 라이선스가 필요하면 절대 경로 지정. 라이선스는 Git에 올리지 않습니다.
GUROBI_LICENSE_FILE=
BIND_ADDRESS=127.0.0.1
PORT=18081
NETWORK_NAME=proteus-gpu-serving
CONTAINER_NAME=proteus-worker-2
WARMUP_QUERIES=10
CPU_THREADS=2
CPU_INTEROP_THREADS=1
PREPROCESS_WORKERS=1
RPC_THREADS=128
MAX_QUEUE_SIZE=256
# 요청 SLO(ms), 배치별 프로파일 반복 횟수, 측정할 배치 크기
SLO_MS=200
PROFILE_TRIALS=30
# continuous: 기존 측정 유지. idle-aware-v1: 휴지 후 실행도 측정 (IDLE_AWARE_PROFILING.md).
PROFILE_STRATEGY=continuous
PROFILE_IDLE_GAPS_MS=0,100,1000
PROFILE_PREDICTION_PERCENTILE=50
PROFILE_TIMEOUT_S=900
BATCH_SIZES=1,2,4,8
ALLOCATION_INTERVAL=1
EWMA_ALPHA=0.7
INITIAL_RATE=1
DEADLINE_GUARD_MS=2
# E2E-minus-worker 추가 시간 예산(ms). 0=기존 동작, 측정 기반 1차 검증 예: 6.
# GPU 프로파일에 더하지 않으며, 정확한 클라이언트 마감시각 전파를 대신하는 고정 근사값입니다.
RPC_BUDGET_MS=0
# CPU/준비 큐의 만료 요청을 조기에 반환. GPU 실행은 강제로 중단하지 않습니다.
EARLY_DEADLINE_DROP=1
# 다른 프로젝트의 GPU 점유를 기본 거부. 공유를 강제하거나 다른 실험을 종료하지 않습니다.
ALLOW_GPU_SHARING=0
