# Existing Proteus/INFaaS/Clipper configuration is never modified.
# Override with baseline.local.env, or BASELINE_GPU / BASELINE_DATA_ROOT etc.
WORKER_IMAGE=proteus-baseline-worker:0.1.0
GPU=2
GPU_TYPE=v100
APPLICATION=imagenet
MODEL_NAME=resnet-50
# Optional pinned SINGLE-model override (e.g. microsoft/resnet-18).
MODEL_ID=
MODEL_REVISION=
MODEL_REGISTRY=deploy/docker/baselines/models.json
DATA_ROOT=data/proteus-baselines
INPUT_IMAGE=inputs/test-dog.jpg
SLO_MS=200
CPU_THREADS=2
WARMUP_QUERIES=10
RPC_THREADS=128
MAX_QUEUE_SIZE=256
PROFILE_TRIALS=30
BATCH_SIZES=1,2,4,8
ALLOCATION_INTERVAL=10
ALLOW_GPU_SHARING=0
PYTHON_IMAGE=python:3.11-slim-bookworm
TORCH_VERSION=2.11.0+cu126
TORCHVISION_VERSION=0.26.0+cu126
