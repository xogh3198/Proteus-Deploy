# Proteus Sommelier comparison GPU port; optional sommelier.local.env overrides.
WORKER_IMAGE=proteus-baseline-worker:sommelier-v1
GPU=2
GPU_TYPE=v100
APPLICATION=imagenet
MODEL_NAME=resnet-50
# Keep both EMPTY for multiple-model selection from MODEL_REGISTRY.
MODEL_ID=
MODEL_REVISION=
MODEL_REGISTRY=deploy/docker/baselines/sommelier-models.json
DATA_ROOT=data/proteus-baselines
EVAL_DIR=data/proteus-baselines/sommelier/eval
INPUT_IMAGE=inputs/test-dog.jpg
SLO_MS=200
BATCH_SIZES=1,2,4,8
PROFILE_TRIALS=30
CPU_THREADS=2
WARMUP_QUERIES=10
RPC_THREADS=128
MAX_QUEUE_SIZE=256
ALLOCATION_INTERVAL=10
EWMA_ALPHA=0.7
INITIAL_RATE=1
DEADLINE_GUARD_MS=2
GUROBI_LICENSE_FILE=
ALLOW_GPU_SHARING=0
PYTHON_IMAGE=python:3.11-slim-bookworm
TORCH_VERSION=2.11.0+cu126
TORCHVISION_VERSION=0.26.0+cu126
