# Same file in v1/v2. Phase is selected by the checked-out branch's phase.json.
GPU=2
GPU_TYPE=v100
EXPECTED_DOCKER_ROOT=/data4tb/taeho-proteus/docker-data
MODEL_DIR=/data4tb/taeho-proteus/paired-resnet-models
DATA_DIR=/data4tb/taeho-proteus/experiments/paired-resnet
INPUT_IMAGE=inputs/test-dog.jpg
WORKLOAD=twitter
SLO_MS=200
BATCH_SIZES=1,2,4,8
PROFILE_TRIALS=30
WARMUP_QUERIES=10
CPU_THREADS=2
CPU_INTEROP_THREADS=1
PREPROCESS_WORKERS=8
RPC_THREADS=128
WORKER_THREADS=32
MAX_QUEUE_SIZE=256
PROTEUS_ALLOCATION_INTERVAL=10
ACCURACY_ALLOCATION_INTERVAL=10
INFAAS_ALLOCATION_INTERVAL=1
EWMA_ALPHA=0.7
INITIAL_RATE=1
DEADLINE_GUARD_MS=2
# Retain the previously measured fixed RPC reserve in the Proteus port.
RPC_BUDGET_MS=6
HW_COST=v100:1
LAMBDA=1.0
SLACK_THRESHOLD=1.05
MIN_ACCURACY=0
CLIPPER_MODE=ha
QUERY_THREADS=16
HOST_PORT=18091
TRACE_SPEED=2
TRACE_CONCURRENCY=256
RPC_TIMEOUT_SECONDS=10
START_STATE=cold
